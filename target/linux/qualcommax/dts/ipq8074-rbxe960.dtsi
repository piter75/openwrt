/* Common hardware description for the Netgear RBRE960 and RBSE960. */

#include "ipq8074-netgear-orbi.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	aliases {
		label-mac-device = &swport5;
		led-boot = &led_front_white;
		led-failsafe = &led_front_red;
		led-upgrade = &led_front_blue;
	};

	chosen {
		bootargs-append = " ubi.mtd=rootfs root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		power-green {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 54 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		power-red {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
		};

		led_front_white: dome-white {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_WHITE>;
			gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>;
		};

		led_front_blue: dome-blue {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 50 GPIO_ACTIVE_HIGH>;
		};

		led_front_red: dome-red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 51 GPIO_ACTIVE_HIGH>;
		};

		led_front_green: dome-green {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 52 GPIO_ACTIVE_HIGH>;
		};
	};
};

&tlmm {
	button_pins: button-pins {
		pins = "gpio33", "gpio34";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-pins {
		pins = "gpio9", "gpio50", "gpio51", "gpio52", "gpio54", "gpio56";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	pcie0_default_state: pcie0-wake-gpio {
		bias-pull-up;
		drive-strength = <8>;
		function = "pcie0_wake";
		pins = "gpio59";
	};
};

&qpic_nand {
	/*
	 * The OEM bootloader injects the SMEM partition table using the legacy
	 * binding and otherwise replaces the annotated partitions below nand@0.
	 * Give its fixup a disabled dummy target so the kernel ignores the
	 * injected nodes while retaining the real qcom,smem-part annotations.
	 */
	partitions {
		status = "disabled";
	};

	nand@0 {
		partitions {
			partition-board_data {
				read-only;
			};

			partition-0-ethphyfw {
				label = "0:ethphyfw";

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					aqr_fw: firmware@0 {
						reg = <0x0 0x60002>;
					};
				};
			};

			partition-0-art {
				label = "0:art";
				read-only;
			};

			partition-0-appsblenv {
				read-only;
			};
		};
	};
};

&mdio {
	qca808x: ethernet-phy@18 {
		compatible = "ethernet-phy-id004d.d101";
		reg = <0x18>;
		reset-assert-us = <10000>;
		reset-deassert-us = <10000>;
		reset-gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
	};
};

&phys {
	qca8075_1: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};

	qca8075_2: ethernet-phy@2 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <2>;
	};

	qca8075_3: ethernet-phy@3 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <3>;
	};
};

&uniphy1 {
	status = "okay";
};

&switch {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		swport2: port@2 {
			reg = <2>;
			label = "lan2";
			phy-handle = <&qca8075_1>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 1>;
			nvmem-cells = <&macaddr_boarddata 1>;
			nvmem-cell-names = "mac-address";
		};

		swport3: port@3 {
			reg = <3>;
			label = "lan3";
			phy-handle = <&qca8075_2>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 2>;
			nvmem-cells = <&macaddr_boarddata 2>;
			nvmem-cell-names = "mac-address";
		};

		swport4: port@4 {
			reg = <4>;
			label = "lan4";
			phy-handle = <&qca8075_3>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 3>;
			nvmem-cells = <&macaddr_boarddata 3>;
			nvmem-cell-names = "mac-address";
		};

		swport5: port@5 {
			reg = <5>;
			label = "lan1";
			phy-handle = <&qca808x>;
			phy-mode = "2500base-x";
			pcs-handle = <&uniphy1 0>;
			nvmem-cells = <&macaddr_boarddata 0>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&wifi {
	qcom,ath11k-calibration-variant = "Netgear-RBRE960";
};

&pcie_qmp0 {
	status = "okay";
};

&pcie0 {
	status = "okay";
	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* ath11k has no DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,ath11k-calibration-variant = "Netgear-RBRE960";
		};
	};
};
